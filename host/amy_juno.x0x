# X0X_AMY (build/host/x0x_amy_host): the Juno patches on the knobs. Each step plays the same
# chord into its own WAV, so the knobs' effects can be measured; the screen is shot at each page.
#   build/host/x0x_amy_host host/amy_juno.x0x OUTDIR
wait 300
shot juno_vcf.png
# A11 Brass Set 1 as stored
wav juno_a11.wav
key w0 down
key w2 down
key w4 down
wait 1000
key w0 up
key w2 up
key w4 up
wait 1200
wavstop
# VCF CUTOFF down 40 steps (darker), then up 80 from there (brighter)
turn K1 -40 10
shot juno_dark.png
wav juno_dark.wav
key w0 down
key w2 down
key w4 down
wait 1000
key w0 up
key w2 up
key w4 up
wait 1200
wavstop
turn K1 80 10
wav juno_bright.wav
key w0 down
key w2 down
key w4 down
wait 1000
key w0 up
key w2 up
key w4 up
wait 1200
wavstop
# ENV page: RELEASE up 30 steps (a longer tail)
turn SELECT 1
turn K4 30 10
shot juno_env.png
wav juno_release.wav
key w0 down
key w2 down
key w4 down
wait 1000
key w0 up
key w2 up
key w4 up
wait 3000
wavstop
# PRESET +4: A15 Moving Strings, its own values on the knobs
turn PRESET 4
shot juno_a15.png
wav juno_a15.wav
key w0 down
key w2 down
key w4 down
wait 1500
key w0 up
key w2 up
key w4 up
wait 1500
wavstop
# OCT+: one key an octave up
tap OCT+
turn SELECT 1
shot juno_osc.png
wav juno_oct.wav
key w0 down
wait 800
key w0 up
wait 1500
wavstop
